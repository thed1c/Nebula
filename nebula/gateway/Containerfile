# The Nebula gateway: iroh's own relay server (n0-computer/iroh, Apache-2.0/MIT), self-hosted. It forwards
# encrypted QUIC between Nebulas that cannot reach each other directly, and cannot read it. Its config
# (/etc/nebula-gateway/relay.toml) is written by Nebula: who may use it (an allowlist of member keys) and TLS.
FROM debian:bookworm-slim
ARG IROH_VERSION=1.3.0
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && curl -fsSL -o /tmp/r.tgz "https://github.com/n0-computer/iroh/releases/download/v${IROH_VERSION}/iroh-relay-v${IROH_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
    && mkdir /tmp/r && tar -xzf /tmp/r.tgz -C /tmp/r && install -m 0755 "$(find /tmp/r -name iroh-relay -type f | head -1)" /usr/local/bin/iroh-relay && rm -rf /tmp/r /tmp/r.tgz \
    && apt-get purge -y curl && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*
EXPOSE 3340 443 80 7842/udp
ENTRYPOINT ["/usr/local/bin/iroh-relay", "--config-path", "/etc/nebula-gateway/relay.toml"]
